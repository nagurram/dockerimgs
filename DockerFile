# Use the official NGINX image as the base image
FROM nginx:latest

# Copy custom configuration file to the NGINX configuration directory
# Uncomment and replace 'custom-nginx.conf' with your file if needed
# COPY custom-nginx.conf /etc/nginx/nginx.conf

# Copy static website files to the default NGINX HTML directory
# Uncomment and replace 'your-static-files/' with your directory if needed
# COPY your-static-files/ /usr/share/nginx/html/

# Expose port 80 for HTTP traffic
EXPOSE 80

# Start NGINX
CMD ["nginx", "-g", "daemon off;"]